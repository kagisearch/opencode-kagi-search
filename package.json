{
  "name": "opencode-kagi-search",
  "version": "0.1.1",
  "description": "OpenCode plugin for Kagi v1 search and extract APIs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "opencode",
    "kagi",
    "search",
    "extract",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
